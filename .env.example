# PostgreSQL connection used by the server (see docker-compose.yml for local defaults)
DATABASE_URL=postgres://contractor:contractor@localhost:5432/contractor_os

# Secret used to sign JWTs — replace with a long random value before any real deployment
JWT_SECRET=change-me-to-a-long-random-string

# Port the API server listens on
PORT=4000

# Comma-separated list of allowed frontend origins for CORS. Leave UNSET in
# local dev (any origin is allowed then, matching the prior default) — set
# this to the real production frontend URL(s) before going live, e.g.:
# CORS_ORIGIN=https://app.example.com
# CORS_ORIGIN=

# PDF generation (quotes/invoices) uses a headless Chromium via Playwright.
# Leave this UNSET normally — run `npx playwright install chromium` once at
# deploy time and Playwright finds its own browser. Only set this if you're
# pointing at a browser already installed somewhere non-standard.
# PLAYWRIGHT_CHROMIUM_PATH=

# --- ZATCA / FATOORA e-invoicing (see server/src/lib/zatca/) ---
# MIDAD never hardcodes a ZATCA hostname or path anywhere in the codebase —
# every value below must be set explicitly, sourced from ZATCA's own
# verified developer documentation, before ZATCA features can reach a real
# endpoint. Leaving these unset is safe: every route that would need them
# fails with a clear configuration error rather than silently doing nothing
# or guessing a URL.
#
# Set the *_SIMULATION_* block to point at ZATCA's Simulation/sandbox
# environment, and the *_PRODUCTION_* block (only once genuinely ready for
# real submissions) at the real FATOORA gateway.
#
# Slice 5 continuation (docs/zatca/SLICE5_OFFICIAL_SPEC_VERIFICATION.md) —
# the user-supplied specification baseline for this deployment named five
# production endpoint paths under one base host
# (gw-fatoora.zatca.gov.sa/e-invoicing):
#   /core/compliance                — CSR submission -> Compliance CSID.
#                                      ZATCA_FATOORA_*_COMPLIANCE_CSID_PATH
#                                      below. The provider method that reads
#                                      it (requestComplianceCsid) exists and
#                                      is tested, but Slice AB intentionally
#                                      does not call it from any route yet —
#                                      see domain/csr.ts's file comment.
#   /core/compliance/invoices       — compliance invoice checks. This is
#                                      what ZATCA_FATOORA_*_COMPLIANCE_PATH
#                                      below actually configures (matches
#                                      fatooraProvider.ts's existing
#                                      submitComplianceDocument/
#                                      checkConnection usage).
#   /core/production/csids          — Compliance CSID -> Production CSID
#                                      exchange (onboarding: POST; renewal:
#                                      PATCH). ZATCA_FATOORA_*_PRODUCTION_CSID_PATH
#                                      below. Same "provider method exists,
#                                      no route calls it yet" status as
#                                      Compliance CSID above.
#   /core/invoices/reporting/single — ZATCA_FATOORA_*_REPORTING_PATH.
#   /core/invoices/clearance/single — ZATCA_FATOORA_*_CLEARANCE_PATH.
#
# Required (URL/path, not secret) — the real submission path
# (routes/zatca.ts's /submissions/:id/submit) throws a clear
# ZatcaConfigurationError at first use if any of these four are unset for
# the environment ("simulation" or "production") the EGS unit being
# submitted through is configured with. Simulation should point at ZATCA's
# Sandbox; Production only once genuinely ready for real submissions.
# ZATCA_FATOORA_SIMULATION_BASE_URL=
# ZATCA_FATOORA_SIMULATION_COMPLIANCE_PATH=
# ZATCA_FATOORA_SIMULATION_CLEARANCE_PATH=
# ZATCA_FATOORA_SIMULATION_REPORTING_PATH=
#
# ZATCA_FATOORA_PRODUCTION_BASE_URL=
# ZATCA_FATOORA_PRODUCTION_COMPLIANCE_PATH=
# ZATCA_FATOORA_PRODUCTION_CLEARANCE_PATH=
# ZATCA_FATOORA_PRODUCTION_REPORTING_PATH=
#
# Optional (URL/path, not secret) — only read by lib/zatca/provider/fatooraClient.ts's
# fatooraRequestComplianceCsid / fatooraRequestProductionCsidOnboarding /
# fatooraRequestProductionCsidRenewal. No route in this codebase calls
# these provider methods yet (see the comment block above), so leaving
# these unset today has no effect on any currently-reachable feature —
# they exist so that future work wiring Compliance/Production CSID
# exchange to a route does not silently guess a path. Set them now only if
# you already know you'll need that future work, or leave unset.
# ZATCA_FATOORA_SIMULATION_COMPLIANCE_CSID_PATH=
# ZATCA_FATOORA_SIMULATION_PRODUCTION_CSID_PATH=
# ZATCA_FATOORA_PRODUCTION_COMPLIANCE_CSID_PATH=
# ZATCA_FATOORA_PRODUCTION_PRODUCTION_CSID_PATH=
#
# Optional (string, not secret) — ZATCA's fixed API version label for this
# environment. Defaults to the verified literal "V2" if unset; only
# override if ZATCA publishes a newer version you've confirmed against
# their own documentation.
# ZATCA_FATOORA_SIMULATION_API_VERSION=
# ZATCA_FATOORA_PRODUCTION_API_VERSION=
#
# Optional (integer, milliseconds, not secret) — shared request timeout for
# every FATOORA HTTP call (both environments). Defaults to 15000 if unset.
# ZATCA_FATOORA_TIMEOUT_MS=15000
#
# Development-only escape hatch letting the in-memory (non-durable)
# ZatcaSecretStore run even when NODE_ENV=production — never set this in a
# real production deployment (see secretStore/index.ts).
# ZATCA_ALLOW_DEV_SECRET_STORE=

# Slice AB — production-grade ZatcaSecretStore (private keys/CSID
# credentials). Set ZATCA_SECRET_STORE_PROVIDER=aws-secrets-manager to use
# AWS Secrets Manager instead of the in-memory dev store; this is an
# explicit, informed choice honored in any NODE_ENV, so it bypasses the
# ZATCA_ALLOW_DEV_SECRET_STORE guard above entirely. Leave unset for
# development/test.
# ZATCA_SECRET_STORE_PROVIDER=aws-secrets-manager
# ZATCA_SECRETS_MANAGER_REGION=
# ZATCA_SECRETS_MANAGER_ACCESS_KEY_ID=
# ZATCA_SECRETS_MANAGER_SECRET_ACCESS_KEY=
# Optional — namespaces secret names (default "midad/zatca").
# ZATCA_SECRETS_MANAGER_KEY_PREFIX=

# ECDSA curve for CSR/CSID key-pair generation (server/src/lib/zatca/csr/).
# SPEC_TEXT_REQUIRED: the specification content this deployment was built
# against does not name a specific curve, and zatca.gov.sa is unreachable
# to confirm one — CSR generation refuses to run until this is set
# explicitly by an operator who has verified the correct value against the
# real ZATCA Security Features Implementation Standard. One of: P-256,
# P-384, P-521 (this runtime's supported WebCrypto ECDSA curves).
# ZATCA_CSR_ECDSA_CURVE=

# --- Slice AA: Email delivery (server/src/lib/mailer.ts) ---
# "console" logs the email to the server console (development/test only —
# NODE_ENV=production refuses to start sending mail without one of these
# explicitly set to "resend", per the fail-closed rule in mailer.ts).
# "resend" sends real email via the Resend API and requires both
# RESEND_API_KEY and MAIL_FROM_ADDRESS below.
# MAIL_PROVIDER=console
# RESEND_API_KEY=
# MAIL_FROM_ADDRESS=

# --- Slice AA: Durable file storage (server/src/lib/storage/) ---
# "local" (default in development) writes to the local uploads/ directory —
# lost on redeploy to an ephemeral host. "s3" uses any S3-compatible
# object store (AWS S3, Cloudflare R2, MinIO, ...) — see s3Provider.ts.
# NODE_ENV=production refuses to silently fall back to "local" (see
# storage/index.ts) — it must be set explicitly.
# STORAGE_PROVIDER=local
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Only needed for a non-AWS S3-compatible endpoint (e.g. Cloudflare R2);
# leave unset for real AWS S3.
# S3_ENDPOINT=
# Public base URL for serving objects from this bucket (e.g. a CDN in
# front of it, or the bucket's own public endpoint). Leave unset if the
# bucket is private — publicUrlFor() then returns null, matching the
# existing StorageProvider contract for a provider that can't serve a
# public URL directly.
# S3_PUBLIC_URL_BASE=
