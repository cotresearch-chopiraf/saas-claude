# PostgreSQL connection used by the server (see docker-compose.yml for local defaults)
DATABASE_URL=postgres://contractor:contractor@localhost:5432/contractor_os

# Secret used to sign JWTs — replace with a long random value before any real deployment
JWT_SECRET=change-me-to-a-long-random-string

# Port the API server listens on
PORT=4000

# Comma-separated list of allowed frontend origins for CORS. Leave UNSET in
# local dev (any origin is allowed then, matching the prior default) — set
# this to the real production frontend URL(s) before going live, e.g.:
# CORS_ORIGIN=https://app.example.com
# CORS_ORIGIN=

# PDF generation (quotes/invoices) uses a headless Chromium via Playwright.
# Leave this UNSET normally — run `npx playwright install chromium` once at
# deploy time and Playwright finds its own browser. Only set this if you're
# pointing at a browser already installed somewhere non-standard.
# PLAYWRIGHT_CHROMIUM_PATH=
